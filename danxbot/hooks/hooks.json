{
  "description": "Injects the danxbot mantra + skill-load routing + the full plan-workflow skill on SessionStart (with per-turn pointers on UserPromptSubmit), and runs the plan event bridge (relays a connected danxbot Plan's dashboard events into the session inbox) plus its watchdog, a plan-link auto-connect hook, a plan-note milestone reminder, and a plan-tab-open reminder. Each script's own header comment documents its exact trigger and behavior.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/zero-context-mandate.sh UserPromptSubmit"
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/plan-workflow-autoload.sh UserPromptSubmit"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/plan-link-connect.mjs\""
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/plan-tab-watch.mjs\" check"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/zero-context-mandate.sh SessionStart"
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/danxbot-skill-mandate.sh SessionStart"
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/plan-workflow-autoload.sh SessionStart"
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/plan-event-bridge.mjs\" start",
            "async": true,
            "asyncRewake": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(mcp__danx_dashboard__plan_connect|mcp__danx-dashboard__plan_connect)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/plan-event-bridge.mjs\" start",
            "async": true,
            "asyncRewake": true
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/plan-tab-watch.mjs\" capture"
          }
        ]
      },
      {
        "matcher": "^(mcp__danx_dashboard__issue_transition|mcp__danx-dashboard__issue_transition|mcp__danx_dashboard__plan_add_record|mcp__danx-dashboard__plan_add_record|mcp__danx_dashboard__plan_update_record|mcp__danx-dashboard__plan_update_record|mcp__danx_dashboard__plan_add_architecture_section|mcp__danx-dashboard__plan_add_architecture_section|mcp__danx_dashboard__plan_update_architecture_section|mcp__danx-dashboard__plan_update_architecture_section)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/plan-note-reminder.mjs\""
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/plan-event-bridge.mjs\" watchdog",
            "async": true,
            "asyncRewake": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/plan-event-bridge.mjs\" watchdog",
            "async": true,
            "asyncRewake": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/plan-event-bridge.mjs\" stop",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
