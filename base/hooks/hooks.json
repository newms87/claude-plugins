{
  "description": "Plugin skill load mandate + convey high-yield-communication mandate. Both fire on SessionStart and UserPromptSubmit so every session has the baseline discipline injected before the first agent action.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/plugin-skill-mandate.sh SessionStart"
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/convey-mandate.sh SessionStart"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/plugin-skill-mandate.sh UserPromptSubmit"
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/convey-mandate.sh UserPromptSubmit"
          }
        ]
      }
    ]
  }
}
