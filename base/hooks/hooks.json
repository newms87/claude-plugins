{
  "description": "Live time injection (UserPromptSubmit + PostToolUse — the model has no other clock). Convey + tool-discipline + current-time mandates (SessionStart). Post-compaction skill-reload gate (SessionStart, source=compact only). Destructive-DB-operation and destructive-git deny guards (PreToolUse Bash), unsafe recursive-delete / mirror-sync target guard (PreToolUse Bash|PowerShell), whole-disk / whole-home tree-walking scan guard for find/grep -r/rg/ls -R/du/dir /s/Get-ChildItem -Recurse (PreToolUse Bash|PowerShell). DX-3347: the operating contract and craft mandate no longer live here — both are folded into the danxbot plugin's mantra.md, printed once at session start/resume/compaction by that plugin's own hook.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/inject-time.sh UserPromptSubmit"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/inject-time.sh PostToolUse"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/convey-mandate.sh SessionStart"
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/tool-discipline-mandate.sh SessionStart"
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/current-time-mandate.sh SessionStart"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/compaction-skill-reload.sh SessionStart"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/deny-destructive-db.mjs"
          },
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/deny-destructive-git.mjs"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/deny-unsafe-recursive-delete.mjs"
          },
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/deny-whole-disk-scan.mjs"
          }
        ]
      }
    ]
  }
}
