{
  "description": "Plugin skill load mandate + convey high-yield-communication mandate (SessionStart) and destructive-DB-operation deny guard (PreToolUse Bash).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/plugin-skill-mandate.sh SessionStart"
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/convey-mandate.sh SessionStart"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/deny-destructive-db.sh"
          }
        ]
      }
    ]
  }
}
